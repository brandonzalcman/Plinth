<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Used only by Scripts/release.sh, and only when a Developer ID provisioning profile is supplied
	(PROVISIONING_PROFILE). It adds iCloud (CloudKit) for container iCloud.dev.getplinth.Plinth, which
	the profile must include. App/Plinth.entitlements stays empty so local and no-team builds work.
	See RELEASING.md and docs/icloud-sync.md.

	Passkeys (com.apple.developer.web-browser.public-key-credential) are deliberately not listed here.
	It is a restricted entitlement, so Scripts/release.sh adds it to a copy of this file only when the
	supplied profile authorises it; signed in without that, the app would not launch. See RELEASING.md.
		-->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.getplinth.Plinth</string>
	</array>
</dict>
</plist>
